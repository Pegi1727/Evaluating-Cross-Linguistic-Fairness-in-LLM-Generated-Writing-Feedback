# Cell 4: Two-Way ANOVA (Model x L1)
model_anova = ols('Overall_Score ~ C(Model) + C(L1) + C(Model):C(L1)', data=df).fit()
anova_table = sm.stats.anova_lm(model_anova, typ=2)
print("\n=== Two-Way ANOVA Table ===")
print(anova_table)

# Cell 5: Human Agreement & Reliability
corr_p, _ = stats.pearsonr(df['Overall_Score'], df['Human_Score'])
corr_s, _ = stats.spearmanr(df['Overall_Score'], df['Human_Score'])
