# Cell 1: Imports and Data Loading
import numpy as np
import pandas as pd
import scipy.stats as stats
import statsmodels.api as sm
from statsmodels.formula.api import ols
import matplotlib.pyplot as plt
import seaborn as sns

# Load Dataset
df = pd.read_csv('Fairness_Full_Dataset.csv')
print("Dataset Shape:", df.shape)
print("\nFirst 5 Rows:")
print(df.head())

# Compute Feedback Quality Index (FQI)
qual_cols = ['Accuracy', 'Helpfulness', 'Specificity', 'Actionability', 'Pedagogical_Appropriateness', 'Socio_Affective_Tone']
df['FQI'] = df[qual_cols].mean(axis=1)

# Cell 2: Descriptive Statistics
print("=== Descriptive Statistics by Model ===")
print(df.groupby('Model')[['Overall_Score', 'FQI', 'Human_Score']].agg(['mean', 'std']))

print("\n=== Descriptive Statistics by L1 ===")
print(df.groupby('L1')[['Overall_Score', 'FQI', 'Human_Score']].agg(['mean', 'std']))

# Cell 3: Prompt Effect (Paired t-test & Wilcoxon)
baseline = df[df['Prompt'] == 'Baseline']['Overall_Score'].values
fairness = df[df['Prompt'] == 'FairnessAware']['Overall_Score'].values

t_stat, p_val_t = stats.ttest_rel(fairness, baseline)
wilc_stat, p_val_w = stats.wilcoxon(fairness, baseline)
cohen_d = (np.mean(fairness) - np.mean(baseline)) / np.std(fairness - baseline)

print("=== Paired Test: Baseline vs FairnessAware ===")
print(f"Mean Difference: {np.mean(fairness) - np.mean(baseline):.4f}")
print(f"Paired t-test: t = {t_stat:.4f}, p = {p_val_t:.4e}")
print(f"Wilcoxon signed-rank: W = {wilc_stat:.4f}, p = {p_val_w:.4e}")
print(f"Cohen's d: {cohen_val_t = stats.ttest_rel(fairness, baseline)
